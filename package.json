{
  "name": "drift-protocol-starter",
  "version": "1.0.0",
  "displayName": "Drift Protocol Trading Starter",
  "description": "Full-stack starter for building trading applications on Drift Protocol with NestJS backend and React frontend",
  "usecase": "DeFi",
  "keywords": ["solana", "drift", "trading", "defi", "perps", "nestjs", "react"],
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "engines": {
    "node": ">=20 <21"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c auto \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm --workspace backend run start:dev",
    "dev:web": "npm --workspace frontend run dev",
    "build": "npm --workspace backend run build && npm --workspace frontend run build"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
